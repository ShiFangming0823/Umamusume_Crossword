{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Random crossword clue bank",
 "type":"object","additionalProperties":false,"required":["schemaVersion","records"],
 "properties":{
  "schemaVersion":{"const":1},"notes":{"$ref":"#/$defs/localized"},
  "records":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["characterId","categories","clues"],"properties":{
   "characterId":{"type":"string","pattern":"^[a-z0-9-]+$"},"categories":{"$ref":"#/$defs/categories"},
   "clues":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","categories","dimension","text","sources"],"properties":{
    "id":{"type":"string","minLength":1},"categories":{"$ref":"#/$defs/categories"},"dimension":{"enum":["profile","horse-record","story","epithet"]},"text":{"$ref":"#/$defs/localized"},"sources":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
   }}}
  }}}
 },
 "$defs":{
  "categories":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["beginner","advanced","epithets","cinderella"]}},
  "localized":{"type":"object","additionalProperties":false,"required":["zh-CN","en","ja"],"properties":{"zh-CN":{"type":"string","minLength":1},"en":{"type":"string","minLength":1},"ja":{"type":"string","minLength":1}}}
 }
}
