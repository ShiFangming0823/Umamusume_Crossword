{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed Cinderella Gray character and scene catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verifiedAt", "sources", "characters", "excluded"],
  "properties": {
    "schemaVersion": {"const": 1},
    "verifiedAt": {"type": "string", "format": "date"},
    "sources": {"$ref": "#/$defs/sources"},
    "characters": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["characterId", "kind", "nameJa", "sources", "clueIds"],
      "properties": {
        "characterId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "kind": {"enum": ["main", "original"]},
        "nameJa": {"type": "string", "minLength": 1},
        "sources": {"$ref": "#/$defs/sources"},
        "clueIds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }},
    "excluded": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["nameEn", "nameJa", "reason", "source"],
      "properties": {
        "nameEn": {"type": "string", "minLength": 1},
        "nameJa": {"type": "string"},
        "reason": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/url"}
      }
    }}
  },
  "$defs": {
    "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/url"}}
  }
}
